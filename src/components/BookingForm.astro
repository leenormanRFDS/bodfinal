<script>
  import { t, bindTranslations } from '../i18n/client';
  import { trackBeginCheckout } from '../lib/tracking';

  const root = document.querySelector<HTMLElement>('[data-booking]');
  if (root) {
    const PACKAGES = JSON.parse(root.querySelector('[data-packages]')!.textContent || '[]');
    const el = (s: string) => root.querySelector(s) as HTMLElement;

    const state: any = { pkg: null, byDate: {}, date: null, session: null, qty: {}, loaded: false };

    const WD = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const MO = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const money = (n: number) => '$' + n.toLocaleString();
    const count = () => (state.pkg ? state.pkg.tiers.reduce((s: number, t: any) => s + (state.qty[t.code] || 0), 0) : 0);
    const total = () => (state.pkg ? state.pkg.tiers.reduce((s: number, t: any) => s + t.price * (state.qty[t.code] || 0), 0) : 0);

    /* ---- Dynamic product hydration: fetch latest pricing & tiers from server ---- */
    fetch('/api/products')
      .then((r) => r.json())
      .then((data) => {
        if (data && data.products) {
          Object.keys(data.products).forEach((slug) => {
            const p = data.products[slug];
            const pkg = PACKAGES.find((x: any) => x.slug === slug);
            if (pkg && p) {
              if (p.lead) {
                pkg.lead = p.lead;
                const leadEl = root.querySelector(`[data-pkg-lead="${slug}"]`);
                if (leadEl) leadEl.textContent = String(p.lead.price);
              }
              if (Array.isArray(p.tiers) && p.tiers.length > 0) {
                pkg.tiers = p.tiers;
              }
              if (p.checkoutUrl) {
                pkg.checkoutUrl = p.checkoutUrl;
              }
            }
          });
          if (state.pkg) {
            renderTickets();
            sync();
          }
        }
      })
      .catch(() => {});

    /* ---- Progressive Accordion State & Management ---- */
    let openStepIndex = 1;

    function isStepAnswered(stepNum: number): boolean {
      if (stepNum === 1) return Boolean(state.pkg);
      if (stepNum === 2) return Boolean(state.pkg && count() > 0);
      if (stepNum === 3) return Boolean(state.date);
      if (stepNum === 4) return Boolean(state.allDay || (state.session && state.session.time));
      return false;
    }

    function openStep(stepNum: number) {
      openStepIndex = stepNum;
      syncAccordion();
    }

    function syncAccordion() {
      const stepIds = ['step-exp', 'step-who', 'step-date', 'step-time'];

      // 01 Experience summary
      const val1 = root.querySelector('[data-step-val="1"]');
      if (val1 && state.pkg) {
        const hasFamily = (state.qty && state.qty['family'] > 0) || (state.pkg.slug === 'general-entry' && count() === 0);
        val1.textContent = hasFamily ? `${state.pkg.name} · Family Pass` : state.pkg.name;
      }

      // 02 Tickets summary
      const val2 = root.querySelector('[data-step-val="2"]');
      if (val2) {
        if (state.pkg && count() > 0) {
          const parts = state.pkg.tiers
            .filter((t: any) => (state.qty[t.code] || 0) > 0)
            .map((t: any) => {
              const qty = state.qty[t.code];
              const isFam = t.code === 'family' || t.label.toLowerCase().includes('family');
              if (isFam) return `${qty} × Family Pass`;
              const plural = qty > 1 && t.label === 'Adult' ? 'Adults' : (qty > 1 && t.label === 'Child' ? 'Children' : t.label);
              return `${qty} ${plural}`;
            });
          val2.textContent = `${parts.join(' + ')} · ${money(total())}`;
        } else {
          val2.textContent = '—';
        }
      }

      // 03 Date summary
      const val3 = root.querySelector('[data-step-val="3"]');
      if (val3) {
        if (state.date) {
          const d = new Date(state.date + 'T00:00:00');
          val3.textContent = `${WD[d.getDay()]} ${d.getDate()} ${MO[d.getMonth()]}`;
        } else {
          val3.textContent = '—';
        }
      }

      // 04 Time summary
      const val4 = root.querySelector('[data-step-val="4"]');
      if (val4) {
        if (state.allDay) val4.textContent = 'Flexible Entry · Valid all day';
        else if (state.session && state.session.time) val4.textContent = state.session.time;
        else val4.textContent = '—';
      }

      // Next buttons state
      const nextBtn2 = root.querySelector('[data-step-next="2"]') as HTMLButtonElement;
      if (nextBtn2) {
        nextBtn2.disabled = count() === 0;
      }

      stepIds.forEach((id, idx) => {
        const stepEl = root.querySelector(`#${id}`) as HTMLElement;
        if (!stepEl) return;
        const stepNum = idx + 1;
        const compact = stepEl.querySelector('.step__compact') as HTMLElement;
        const body = stepEl.querySelector('.step__body') as HTMLElement;

        if (openStepIndex === stepNum) {
          stepEl.setAttribute('data-state', 'open');
          if (compact) compact.setAttribute('aria-expanded', 'true');
          if (body) body.hidden = false;
        } else if (isStepAnswered(stepNum)) {
          stepEl.setAttribute('data-state', 'collapsed');
          if (compact) compact.setAttribute('aria-expanded', 'false');
          if (body) body.hidden = true;
        } else {
          stepEl.setAttribute('data-state', 'pending');
          if (compact) compact.setAttribute('aria-expanded', 'false');
          if (body) body.hidden = true;
        }
      });
    }

    // Step navigation buttons
    const nextBtn1 = root.querySelector('[data-step-next="1"]');
    if (nextBtn1) nextBtn1.addEventListener('click', () => openStep(2));

    const nextBtn2 = root.querySelector('[data-step-next="2"]');
    if (nextBtn2) nextBtn2.addEventListener('click', () => {
      if (count() > 0) openStep(3);
    });

    // Edit buttons & compact row toggles
    root.querySelectorAll<HTMLButtonElement>('[data-step-edit]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const s = Number(btn.dataset.stepEdit);
        if (s) openStep(s);
      });
    });

    root.querySelectorAll<HTMLElement>('[data-step-toggle]').forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const s = Number(toggle.dataset.stepToggle);
        if (s && isStepAnswered(s)) openStep(s);
      });
      toggle.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const s = Number(toggle.dataset.stepToggle);
          if (s && isStepAnswered(s)) openStep(s);
        }
      });
    });

    /* ---- 01 · package select ---- */
    const packBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-pkg]'));
    function selectPkg(slug: string, advance = false, initFamily = false) {
      const pkg = PACKAGES.find((p: any) => p.slug === slug);
      if (!pkg) return;
      state.pkg = pkg; state.date = null; state.session = null; state.qty = {}; state.loaded = false;
      pkg.tiers.forEach((t: any) => (state.qty[t.code] = 0));
      if (initFamily || slug === 'general-entry') {
        const fam = pkg.tiers.find((t: any) => t.code === 'family' || t.label.toLowerCase().includes('family'));
        if (fam) state.qty[fam.code] = 1;
      }
      packBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pkg === slug)));
      renderTickets();
      load(pkg);
      sync();
      if (advance) {
        openStep(2);
      } else {
        syncAccordion();
      }
    }
    packBtns.forEach((b) => b.addEventListener('click', () => selectPkg(b.dataset.pkg!, true)));
    const want = new URLSearchParams(location.search).get('pkg') || 'general-entry';
    setTimeout(() => selectPkg(want, false, want === 'general-entry'), 30);

    /* ---- 02 · steppers ---- */
    function renderTickets() {
      const c = el('[data-tickets]'); c.innerHTML = '';
      state.pkg.tiers.forEach((tData: any) => {
        const row = document.createElement('div'); row.className = 'trow';
        const currentQty = state.qty[tData.code] || 0;
        const subtotalText = currentQty > 0 ? ` · ${money(tData.price * currentQty)}` : '';
        const tierKey = tData.code === 'adult' ? 'tickets.tiers.adult' :
          tData.code === 'child' ? 'tickets.tiers.child' :
          tData.code === 'concession' ? 'tickets.tiers.concession' :
          tData.code === 'family' ? 'tickets.tiers.family' : null;
        const displayLabel = tierKey ? t(tierKey) : tData.label;

        row.innerHTML =
          `<div class="trow__info"><span class="trow__label">${displayLabel}</span><span class="trow__sub"><b>${money(tData.price)}</b>${tData.note ? ' · ' + tData.note : ''}<span class="trow__subtotal" data-subtotal>${subtotalText}</span></span></div>` +
          `<div class="stepper"><button type="button" class="stepper__b" data-dec aria-label="Fewer ${displayLabel}">−</button><span class="stepper__n" data-count aria-live="polite">${currentQty}</span><button type="button" class="stepper__b" data-inc aria-label="More ${displayLabel}">+</button></div>`;
        const cnt = row.querySelector('[data-count]') as HTMLElement;
        const dec = row.querySelector('[data-dec]') as HTMLButtonElement;
        const sub = row.querySelector('[data-subtotal]') as HTMLElement;
        const upd = () => {
          cnt.textContent = String(state.qty[tData.code]);
          dec.disabled = state.qty[tData.code] === 0;
          if (sub) {
            sub.textContent = state.qty[tData.code] > 0 ? ` · ${money(tData.price * state.qty[tData.code])}` : '';
          }
          sync();
        };
        dec.addEventListener('click', () => { state.qty[tData.code] = Math.max(0, state.qty[tData.code] - 1); upd(); });
        row.querySelector('[data-inc]')!.addEventListener('click', () => { state.qty[tData.code] = Math.min(tData.max || 20, state.qty[tData.code] + 1); upd(); });
        dec.disabled = currentQty === 0;
        c.appendChild(row);
      });
    }

    /* ---- 03 · date timeline (28 days, unavailable greyed) ---- */
    async function load(pkg: any) {
      const c = el('[data-dates]');
      c.innerHTML = '<p class="hint">Loading availability…</p>';
      let data: any = null;
      try {
        const r = await fetch(`/api/availability?product=${encodeURIComponent(pkg.slug)}`);
        data = await r.json();
      } catch {
        data = null;
      }
      if (!data || !data.sessions) data = { mock: true, sessions: [] };
      el('[data-mocknote]').hidden = !data.mock;

      // Update tiers & checkout URL dynamically from product query if provided
      if (Array.isArray(data.tiers) && data.tiers.length > 0) {
        pkg.tiers = data.tiers;
        data.tiers.forEach((t: any) => {
          if (state.qty[t.code] == null) {
            state.qty[t.code] = (t.code === 'family' || t.label.toLowerCase().includes('family')) ? 1 : 0;
          }
        });
        renderTickets();
      }
      if (data.checkoutUrl) {
        pkg.checkoutUrl = data.checkoutUrl;
      }
      if (data.lead) {
        pkg.lead = data.lead;
        const leadEl = root.querySelector(`[data-pkg-lead="${pkg.slug}"]`);
        if (leadEl) leadEl.textContent = String(data.lead.price);
      }

      state.byDate = {};
      data.sessions.forEach((s: any) => { if (s.seatsAvailable === 0) return; (state.byDate[s.date] = state.byDate[s.date] || []).push(s); });
      // all-day products (combos): every session starts 00:00 — no time to choose
      state.allDay = data.sessions.length > 0 && data.sessions.every((s: any) => !s.time || s.time === '00:00');
      state.loaded = true;
      renderCal();
      sync();
    }
    function renderCal() {
      const c = el('[data-dates]'); c.innerHTML = '';
      const today = new Date();
      for (let i = 0; i < 28; i++) {
        const d = new Date(today); d.setDate(today.getDate() + i);
        const iso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        const has = !!state.byDate[iso];
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'day'; b.disabled = !has; b.setAttribute('aria-pressed', 'false');
        b.innerHTML = `<span class="day__wd">${WD[d.getDay()]}</span><span class="day__num">${d.getDate()}</span><span class="day__mo">${MO[d.getMonth()]}`;
        if (has) b.addEventListener('click', () => {
          state.date = iso;
          c.querySelectorAll('.day').forEach((x) => x.setAttribute('aria-pressed', 'false'));
          b.setAttribute('aria-pressed', 'true');
          if (state.allDay) {
            state.session = state.byDate[iso][0];
            renderSessions();
            openStep(4);
          } else {
            state.session = null;
            renderSessions();
            openStep(4);
          }
          sync();
        });
        c.appendChild(b);
      }
    }

    /* ---- 04 · time ---- */
    function renderSessions() {
      const c = el('[data-sessions]'); c.innerHTML = '';
      if (state.allDay) {
        c.innerHTML = `
          <div class="allday-banner">
            <span class="allday-badge">Flexible Entry</span>
            <p class="allday-text">Your ticket is valid anytime between <strong>9:00 AM – 4:00 PM</strong> on your selected date. No time reservation required.</p>
            <div class="step__nav" style="margin-top:16px;padding-top:16px;border-top:none;justify-content:flex-start;">
              <button type="button" class="btn-step-next" data-confirm-time>
                <span>Confirm Selection</span> <i>✓</i>
              </button>
            </div>
          </div>
        `;
        const cfm = c.querySelector('[data-confirm-time]');
        if (cfm) cfm.addEventListener('click', () => {
          openStep(0);
          sync();
        });
        return;
      }
      (state.byDate[state.date] || []).sort((a: any, b: any) => a.time.localeCompare(b.time)).forEach((s: any) => {
        const low = s.seatsAvailable != null && s.seatsAvailable <= 8;
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'slot'; b.setAttribute('aria-pressed', 'false');
        b.innerHTML = `<span class="slot__t">${s.time}</span>${low ? `<span class="slot__seats">${s.seatsAvailable} left</span>` : ''}`;
        b.addEventListener('click', () => {
          state.session = s;
          c.querySelectorAll('.slot').forEach((x) => x.setAttribute('aria-pressed', 'false'));
          b.setAttribute('aria-pressed', 'true');
          openStep(0);
          sync();
        });
        c.appendChild(b);
      });
    }

    /* ---- Your Visit ---- */
    const cta = el('[data-book]') as HTMLButtonElement;
    function sync() {
      el('[data-sum-pkg]').textContent = state.pkg ? state.pkg.name : '—';
      const parts = state.pkg ? state.pkg.tiers.filter((t: any) => state.qty[t.code] > 0).map((t: any) => `${state.qty[t.code]} × ${t.label}`) : [];
      el('[data-sum-qty]').textContent = parts.length ? parts.join(', ') : '—';
      if (state.date) {
        const d = new Date(state.date + 'T00:00:00');
        el('[data-sum-date]').textContent = `${WD[d.getDay()]} ${d.getDate()} ${MO[d.getMonth()]}`;
      } else el('[data-sum-date]').textContent = '—';
      el('[data-sum-time]').textContent = state.session ? (state.allDay ? 'Valid all day' : state.session.time) : '—';
      el('[data-total]').textContent = money(total());

      const n = count();
      if (!state.pkg || n === 0) { cta.textContent = t('tickets.continue'); cta.disabled = !state.pkg; }
      else if (!state.date || !state.session) { cta.textContent = `${t('nav.bookTickets')} (${n}) • ${money(total())}`; cta.disabled = false; }
      else { cta.textContent = `${t('tickets.continue')} • ${money(total())}`; cta.disabled = false; }

      syncAccordion();
    }

    window.addEventListener('bod:locale_changed', () => {
      bindTranslations(root);
      if (state.pkg) {
        renderTickets();
        sync();
      }
    });
    /* ---- In-site checkout modal (Rezdy embed — the visitor never leaves us) ---- */
    const modal = document.querySelector<HTMLElement>('[data-comodal]')!;
    const frame = modal.querySelector<HTMLElement>('.co-modal__frame')!;
    const coTitle = modal.querySelector<HTMLElement>('[data-cotitle]')!;
    let lenisPaused = false;

    const tabPanel = modal.querySelector<HTMLElement>('[data-cotab]')!;
    const tabLink = modal.querySelector<HTMLAnchorElement>('[data-cotablink]');
    const remind = modal.querySelector<HTMLElement>('[data-coremind]');

    /**
     * Apple devices run Rezdy in its own tab, not an iframe. Safari's cross-site tracking
     * prevention (on by default; every iOS browser is WebKit) blocks Rezdy's cookies inside
     * an iframe, and Rezdy's own advice is for guests to switch that protection off.
     * As a first-party page in its own tab, Rezdy's checkout works normally.
     */
    const needsOwnTab = (() => {
      const ua = navigator.userAgent;
      const iOS = /iPad|iPhone|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
      const macSafari = /Safari/.test(ua) && !/Chrome|Chromium|CriOS|FxiOS|Edg|OPR|Android/.test(ua);
      return iOS || macSafari || new URLSearchParams(location.search).get('checkout') === 'tab';
    })();

    /** Reminder of the selection: Rezdy ignores quantities passed by link (verified 25 Oct 2026). */
    function selectionText() {
      const parts = state.pkg.tiers
        .filter((t: any) => state.qty[t.code] > 0)
        .map((t: any) => `${state.qty[t.code]} × ${t.label}`);
      const when = [state.date || '', state.allDay ? 'Flexible entry' : (state.session ? state.session.time : '')].filter(Boolean).join(' · ');
      return { parts: parts.join(', '), when };
    }

    function openCheckout(tab: Window | null = null) {
      const returnTarget = `${window.location.origin}/tickets/confirmation?product=${encodeURIComponent(state.pkg.slug)}&date=${encodeURIComponent(state.date || '')}&time=${encodeURIComponent(state.session ? (state.allDay ? 'Flexible Entry' : state.session.time) : '')}`;
      const params = new URLSearchParams({
        redirectUrl: returnTarget,
        returnUrl: returnTarget,
      });
      if (!needsOwnTab) params.set('iframe', 'true');
      // Rezdy honours `date` (pre-selects the day). Quantities/time are passed for completeness
      // but Rezdy ignores them; the reminder bar tells the visitor what to choose.
      if (state.date) params.set('date', state.date);
      if (state.session && state.session.time && !state.allDay) params.set('time', state.session.time);
      state.pkg.tiers.forEach((t: any) => {
        if (state.qty[t.code]) params.set(t.code, String(state.qty[t.code]));
      });
      const baseCheckout = state.pkg.checkoutUrl || 'https://rfdsdarwin1.rezdy.com';
      const sep = baseCheckout.includes('?') ? '&' : '?';
      const checkoutUrl = `${baseCheckout}${sep}${params.toString()}`;

      const sel = selectionText();
      if (remind) {
        remind.innerHTML = '';
        remind.append('In checkout, choose ');
        const b = document.createElement('b'); b.textContent = sel.parts || 'your tickets'; remind.append(b);
        if (sel.when) remind.append(` · ${sel.when}`);
        remind.hidden = false;
      }

      // fresh iframe each open so availability is current
      frame.querySelectorAll('iframe').forEach((f) => f.remove());
      const load = modal.querySelector<HTMLElement>('[data-coload]');

      if (needsOwnTab) {
        frame.hidden = true;
        tabPanel.hidden = false;
        if (tabLink) tabLink.href = checkoutUrl;
        if (tab && !tab.closed) {
          tab.location.href = checkoutUrl;
        } else {
          // Popup blocked: continue in this tab (purchase is still verified on return via Rezdy).
          window.location.href = checkoutUrl;
          return;
        }
      } else {
        frame.hidden = false;
        tabPanel.hidden = true;
        if (load) load.style.display = 'flex';
        const iframe = document.createElement('iframe');
        iframe.src = checkoutUrl;
        iframe.title = 'Secure checkout';
        iframe.allow = 'payment';
        iframe.addEventListener('load', () => {
          if (load) load.style.display = 'none';
        });
        frame.appendChild(iframe);
      }

      const extLink = modal.querySelector<HTMLAnchorElement>('[data-coext]');
      if (extLink) { extLink.href = checkoutUrl; extLink.hidden = needsOwnTab; }

      coTitle.textContent = state.pkg.name;
      const descEl = modal.querySelector<HTMLElement>('[data-codesc]');
      if (descEl) {
        const timeStr = state.allDay ? 'Flexible Entry' : (state.session ? state.session.time : '');
        descEl.textContent = `${state.date || ''} ${timeStr ? '· ' + timeStr : ''} · Royal Flying Doctor Service`;
      }

      trackBeginCheckout({
        productSlug: state.pkg.slug,
        productName: state.pkg.name,
        value: total(),
        items: state.pkg.tiers
          .filter((t: any) => state.qty[t.code])
          .map((t: any) => ({ item_id: state.pkg.slug, item_name: state.pkg.name, item_variant: t.label, price: t.price, quantity: state.qty[t.code] })),
      });

      modal.classList.add('is-open'); modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('co-open');
      const lenis = (window as any).__lenis; if (lenis) { lenis.stop(); lenisPaused = true; }
    }
    function closeCheckout() {
      modal.classList.remove('is-open'); modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('co-open');
      const lenis = (window as any).__lenis; if (lenis && lenisPaused) { lenis.start(); lenisPaused = false; }
    }
    modal.querySelectorAll('[data-coclose]').forEach((b) => b.addEventListener('click', closeCheckout));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal.classList.contains('is-open')) closeCheckout(); });

    // Booking-complete message from Rezdy's thank-you page (iframe parent or opener tab).
    // Only Rezdy origins are trusted; the confirmation page re-verifies the order server-side.
    window.addEventListener('message', (event) => {
      try {
        let host = '';
        try { host = new URL(event.origin).hostname; } catch {}
        if (!(host === 'rezdy.com' || host.endsWith('.rezdy.com'))) return;
        const d = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
        if (d && (d.action === 'rezdy:orderConfirmed' || d.event === 'order_confirmed' || d.type === 'rezdy:bookingComplete' || d.orderNumber)) {
          const orderNum = String(d.orderNumber || d.bookingNumber || '').replace(/[^A-Za-z0-9-]/g, '');
          if (!orderNum) return;
          window.location.href = `/tickets/confirmation?orderNumber=${encodeURIComponent(orderNum)}&product=${encodeURIComponent(state.pkg.slug)}&date=${encodeURIComponent(state.date || '')}&time=${encodeURIComponent(state.session ? (state.allDay ? 'Flexible Entry' : state.session.time) : '')}`;
        }
      } catch {}
    });

    cta.addEventListener('click', async () => {
      if (!state.pkg) { openStep(1); return; }
      if (count() === 0) { openStep(2); return; }
      if (!state.date) { openStep(3); return; }
      if (!state.session && !state.allDay) { openStep(4); return; }

      // Open the checkout tab now, inside the tap: iOS blocks window.open after an await.
      let tab: Window | null = null;
      if (needsOwnTab) {
        tab = window.open('', '_blank');
        if (tab) {
          try {
            tab.document.title = 'Secure checkout';
            tab.document.body.style.cssText = 'margin:0;display:grid;place-items:center;height:100vh;background:#0c0c0b;color:#e8e2d4;font:16px system-ui,sans-serif';
            tab.document.body.textContent = 'Opening secure checkout…';
          } catch {}
        }
      }

      const alertEl = root.querySelector<HTMLElement>('[data-verifyalert]');
      if (alertEl) alertEl.hidden = true;

      // Enter pre-flight verification state
      const origText = cta.textContent;
      cta.disabled = true;
      cta.textContent = 'Verifying Availability…';

      try {
        const verifyRes = await fetch('/api/rezdy/verify-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            productSlug: state.pkg.slug,
            date: state.date,
            time: state.session ? state.session.time : undefined,
            sessionId: state.session ? state.session.id : undefined,
            qty: state.qty,
          }),
        });
        const verifyData = await verifyRes.json();

        if (verifyData && verifyData.available) {
          sync();
          openCheckout(tab);
        } else {
          if (tab) tab.close();
          sync();
          if (alertEl) {
            alertEl.textContent = verifyData?.message || 'The selected session is no longer available. Please choose another time or date.';
            alertEl.hidden = false;
          }
          const targetStep = state.allDay ? 3 : 4;
          openStep(targetStep);
        }
      } catch (err) {
        // Resilient fallback: if network probe times out, allow proceeding to Rezdy hosted checkout
        sync();
        openCheckout(tab);
      }
    });
    sync();
  }
</script>
