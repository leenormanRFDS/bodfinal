---
// Measurement tags (GA4, optional Meta pixel, optional GTM).
//
// - Production hostnames only (ANALYTICS.productionHosts): previews, *.vercel.app and
//   localhost never send data.
// - Queues are created immediately (window.dataLayer / gtag / fbq), so nothing is lost,
//   but the vendor scripts load after the page's `load` event so they never compete with
//   the hero image or fonts.
// - Events go through window.bodTrack (src/lib/tracking.ts), which fans out to GA4 + Meta.
import { ANALYTICS } from '../consts';
const enabled = import.meta.env.PROD;
const cfg = JSON.stringify({
  ga4: ANALYTICS.ga4MeasurementId,
  pixel: ANALYTICS.metaPixelId,
  gtm: ANALYTICS.gtmContainerId,
  hosts: ANALYTICS.productionHosts,
});
---
{enabled && (
  <script is:inline define:vars={{ cfg }}>
    (function () {
      var c = JSON.parse(cfg);
      var on = c.hosts.indexOf(location.hostname) !== -1 || /[?&]bod_track=1/.test(location.search);
      window.__bodTrackingOn = on;
      if (!on) return;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      if (c.ga4 && !c.gtm) window.gtag('config', c.ga4);
      if (c.gtm) window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
      if (c.pixel) {
        var f = (window.fbq = function () { f.callMethod ? f.callMethod.apply(f, arguments) : f.queue.push(arguments); });
        if (!window._fbq) window._fbq = f;
        f.push = f; f.loaded = true; f.version = '2.0'; f.queue = [];
        window.fbq('init', c.pixel);
        window.fbq('track', 'PageView');
      }
      function add(src) { var s = document.createElement('script'); s.async = true; s.src = src; document.head.appendChild(s); }
      function load() {
        if (c.gtm) add('https://www.googletagmanager.com/gtm.js?id=' + c.gtm);
        else if (c.ga4) add('https://www.googletagmanager.com/gtag/js?id=' + c.ga4);
        if (c.pixel) add('https://connect.facebook.net/en_US/fbevents.js');
      }
      if (document.readyState === 'complete') load(); else window.addEventListener('load', load, { once: true });
    })();
  </script>
)}
