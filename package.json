{
  "name": "bombing-of-darwin",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "cesium:assets": "node scripts/sync-cesium-assets.mjs",
    "dev": "node scripts/sync-cesium-assets.mjs && astro dev --host 0.0.0.0 --port 3000",
    "build": "node scripts/sync-cesium-assets.mjs && astro build && node scripts/vercel-cache-headers.mjs",
    "profile:spatial": "node scripts/profile-spatial-load.mjs",
    "capture:spatial": "node scripts/capture-spatial.mjs",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "lint": "astro sync",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.10",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tolgee/web": "^7.2.1",
    "astro": "^7.3.1",
    "cesium": "^1.145.0",
    "gsap": "^3.13.0",
    "lenis": "^1.1.20",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "playwright-core": "^1.63.0"
  }
}
